---
import { url } from '../lib/paths';
const home = url('');
const links = [
  ['work', 'Work'],
  ['experience', 'Experience'],
  ['research', 'Research'],
  ['about', 'About'],
  ['contact', 'Contact'],
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand mono" href={home} aria-label="Home">
      <span class="brand-box">AJ</span><span class="brand-txt">akshaya.jeyaprakash</span>
    </a>
    <nav aria-label="Sections">
      <ul>
        {links.map(([id, label], i) => (
          <li><a href={`${home}#${id}`}><span class="idx">0{i + 1}</span>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-size: 13px; color: var(--ink-2); }
  .brand-box { border: 1.5px solid var(--accent); color: var(--accent); padding: 2px 6px; font-weight: 600; }
  ul { display: flex; gap: clamp(12px, 2.4vw, 32px); list-style: none; margin: 0; padding: 0; }
  a { text-decoration: none; }
  nav a { font-family: var(--font-mono); font-size: 13px; color: var(--ink-2); display: flex; gap: 6px; transition: color .2s; }
  nav a:hover { color: var(--accent); }
  .idx { color: var(--muted); }
  @media (max-width: 860px) {
    .brand-txt { display: none; }
    .idx { display: none; }
    nav { overflow-x: auto; scrollbar-width: none; }
    ul { gap: 14px; }
    nav a { font-size: 12px; }
  }
</style>
