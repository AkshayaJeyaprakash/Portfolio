---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Media from '../components/Media.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { experience, education } from '../data/experience';
import { publications, skills, foundations, awards } from '../data/research';
import { url } from '../lib/paths';
---
<Base>
  <Hero />

  <!-- 01 WORK -->
  <section class="section" id="work">
    <div class="wrap">
      <p class="eyebrow">01 / Selected work</p>
      <h2 class="h-section">Robots that listen,<br />look, and act.</h2>
      <p class="lede">Four systems from my last year at ASU. Each one starts with a camera frame or a plain English sentence and ends with a robot doing the job.</p>

      <div class="projects">
        {projects.map((p, i) => (
          <article class="project reveal" style={`--box: var(${['--accent', '--cyan', '--pink', '--accent'][i % 4]})`}>
            <a class="p-media bbox" href={url(`projects/${p.slug}/`)} aria-label={`${p.title} case study`}>
              <Media item={p.cover} showCaption={false} autoplay={p.cover.kind === 'video'} />
              <span class="label p-label">{p.label} 0.9{8 - i}</span>
            </a>
            <div class="p-body">
              <p class="p-meta mono">{String(i + 1).padStart(2, '0')} · {p.when} · {p.team}</p>
              <h3 class="p-title">{p.title}</h3>
              <p class="p-tag">{p.tagline}</p>
              <dl class="p-metrics">
                {p.metrics.slice(0, 3).map((m) => (
                  <div><dt>{m.value}</dt><dd>{m.label}</dd></div>
                ))}
              </dl>
              <ul class="tags">{p.stack.slice(0, 6).map((s) => <li class="tag">{s}</li>)}</ul>
              <div class="p-links">
                <a class="btn" href={url(`projects/${p.slug}/`)}>Case study →</a>
                <a class="arrow-link" href={p.repo} target="_blank" rel="noopener">code ↗</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 EXPERIENCE -->
  <section class="section gridbg-soft" id="experience">
    <div class="wrap">
      <p class="eyebrow">02 / Experience</p>
      <h2 class="h-section">From production<br />agents to research labs.</h2>

      <div class="filters mono" role="group" aria-label="Filter experience">
        <button class="on" data-filter="all">all <span>{experience.length}</span></button>
        <button data-filter="industry">industry <span>{experience.filter((e) => e.kind === 'industry').length}</span></button>
        <button data-filter="research">research <span>{experience.filter((e) => e.kind === 'research').length}</span></button>
      </div>

      <ol class="timeline">
        {experience.map((r) => (
          <li class="role reveal" data-kind={r.kind}>
            <div class="r-when mono">
              <span>{r.start} to {r.end}</span>
              <span class:list={['r-kind', r.kind]}>{r.kind}</span>
            </div>
            <div class="r-body">
              <h3><span class="r-title">{r.title}</span> <span class="r-org">@ {r.org}{r.place ? `, ${r.place}` : ''}</span></h3>
              <ul class="r-points">{r.points.map((pt) => <li>{pt}</li>)}</ul>
              <ul class="tags">{r.tags.map((t) => <li class="tag">{t}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 RESEARCH -->
  <section class="section" id="research">
    <div class="wrap">
      <p class="eyebrow">03 / Research & education</p>
      <h2 class="h-section">Six papers,<br />two degrees.</h2>

      <div class="research">
        <ol class="pubs">
          {publications.map((p, i) => (
            <li class="pub reveal">
              <span class="pub-n mono">[{String(i + 1).padStart(2, '0')}]</span>
              <div>
                <p class="pub-title">{p.link ? <a href={p.link} target="_blank" rel="noopener">{p.title} ↗</a> : p.title}</p>
                <p class="pub-venue mono">{p.type} · {p.venue}{p.year ? ` · ${p.year}` : ''}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="edu">
          {education.map((e) => (
            <div class="edu-card bbox reveal">
              <p class="mono edu-when">{e.when}</p>
              <h3>{e.school}</h3>
              <p>{e.degree}</p>
              <p class="edu-detail">{e.detail}</p>
              <p class="edu-score mono">{e.score}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 04 ABOUT -->
  <section class="section gridbg-soft" id="about">
    <div class="wrap">
      <p class="eyebrow">04 / About</p>
      <div class="about">
        <div>
          <h2 class="h-section">Literature to<br />lab to launch.</h2>
          {profile.about.map((p) => <p class="lede">{p}</p>)}
        </div>
        <dl class="stats">
          {profile.stats.map((s) => (
            <div class="reveal"><dt>{s.value}</dt><dd class="mono">{s.label}</dd></div>
          ))}
        </dl>
      </div>

      <div class="skills">
        {skills.map((g) => (
          <div class="skill reveal">
            <h3 class="mono">{g.group}</h3>
            <ul class="tags">{g.items.map((s) => <li class="tag">{s}</li>)}</ul>
          </div>
        ))}
      </div>

      <div class="extras">
        <h3 class="mono sub">Awards</h3>
        <ul class="awards">
          {awards.map((a) => (
            <li class:list={['award', 'reveal', { feature: a.detail }]}>
              <span class="a-year mono">{a.year}</span>
              <div>
                <p class="a-title">{a.title} <span class="a-event">· {a.event}</span></p>
                {a.detail && <p class="a-detail">{a.detail}</p>}
                {a.tags && <ul class="tags">{a.tags.map((t) => <li class="tag">{t}</li>)}</ul>}
                {a.link && <a class="arrow-link" href={a.link} target="_blank" rel="noopener">code ↗</a>}
              </div>
              {a.image && (
                <figure class="a-photo">
                  <img src={url(a.image.src)} alt={a.image.alt} loading="lazy" />
                  <span class="label">winners 0.99</span>
                </figure>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 05 FOUNDATIONS -->
  <section class="section" id="foundations">
    <div class="wrap">
      <p class="eyebrow">05 / Foundations</p>
      <h2 class="h-section sm">Where I learned<br />to build.</h2>
      <p class="lede">Before the robots: {foundations.length} undergrad projects across deep learning, optimization, hardware and systems. Some still map straight onto industry problems, and every one of them taught me something I use today. Click any project to open it up.</p>
      <div class="fnd-tools mono">
        <button type="button" data-fnd-toggle>expand all +</button>
      </div>
      <ul class="fnd">
        {foundations.map((f) => (
          <li>
            <details class="fnd-item">
              <summary>
                <span class="f-year mono">{f.year}</span>
                <span class="f-title">{f.title}</span>
                <span class="f-area mono">{f.area}</span>
                <span class="f-icon mono" aria-hidden="true">+</span>
              </summary>
              <div class="f-body">
                <p>{f.what}</p>
                <p class="f-learned"><span class="mono">what it taught me →</span> {f.learned}</p>
                {f.link && <a class="arrow-link" href={f.link} target="_blank" rel="noopener">view project ↗</a>}
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 06 CONTACT -->
  <section class="section contact gridbg" id="contact">
    <div class="wrap">
      <p class="eyebrow">06 / Contact</p>
      <h2 class="h-section xl">Let’s build<br />something<br /><span class="hl">that moves.</span></h2>
      <p class="lede">Open to conversations about AI engineering and robotics, including research collaborations, internships and full-time roles.</p>
      <div class="ctas">
        <a class="btn solid" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn ghost" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a class="btn ghost" href={profile.links.github} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const roles = document.querySelectorAll<HTMLElement>('.role');
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.classList.toggle('on', x === b));
    const f = b.dataset.filter;
    roles.forEach((r) => { r.hidden = f !== 'all' && r.dataset.kind !== f; });
  }));

  const fndToggle = document.querySelector<HTMLButtonElement>('[data-fnd-toggle]');
  const fndItems = document.querySelectorAll<HTMLDetailsElement>('.fnd-item');
  fndToggle?.addEventListener('click', () => {
    const open = [...fndItems].some((d) => !d.open);
    fndItems.forEach((d) => { d.open = open; });
    fndToggle.textContent = open ? 'collapse all −' : 'expand all +';
  });
</script>

<style>
  .gridbg-soft { background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
  .h-section.sm { font-size: clamp(34px, 5vw, 60px); }
  .h-section.xl { font-size: clamp(48px, 10vw, 140px); }
  .hl { color: var(--accent); }

  /* Projects */
  .projects { display: grid; gap: clamp(64px, 10vw, 120px); margin-top: clamp(48px, 8vw, 96px); }
  .project { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .project:nth-child(even) .p-media { order: 2; }
  .p-media { position: relative; display: block; }
  .p-label { position: absolute; left: 0; top: -20px; }
  .p-meta { font-size: 12px; color: var(--muted); margin: 0; }
  .p-title { font-size: clamp(34px, 4.5vw, 56px); line-height: 1; letter-spacing: -.035em; margin: 12px 0 0; }
  .p-tag { color: var(--ink-2); font-size: 18px; margin: 14px 0 0; }
  .p-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 24px 0; padding: 18px 0; border-block: 1px solid var(--line); }
  .p-metrics dt { font-size: clamp(20px, 2.2vw, 28px); font-weight: 600; color: var(--box); letter-spacing: -.02em; line-height: 1.1; }
  .p-metrics dd { margin: 6px 0 0; font-size: 12.5px; color: var(--muted); line-height: 1.4; }
  .p-links { display: flex; align-items: center; gap: 20px; margin-top: 24px; }

  /* Experience */
  .filters { display: flex; gap: 8px; margin: 40px 0 8px; flex-wrap: wrap; }
  .filters button { font: inherit; font-size: 13px; background: none; color: var(--ink-2); border: 1px solid var(--line-2); padding: 8px 14px; cursor: pointer; }
  .filters button span { color: var(--muted); margin-left: 4px; }
  .filters button.on { border-color: var(--accent); color: var(--accent); }
  .timeline { list-style: none; padding: 0; margin: 24px 0 0; }
  .role { display: grid; grid-template-columns: 220px 1fr; gap: 24px; padding: 32px 0; border-top: 1px solid var(--line); }
  .role[hidden] { display: none; }
  .r-when { font-size: 12.5px; color: var(--muted); display: grid; gap: 10px; align-content: start; }
  .r-kind { justify-self: start; font-size: 11px; padding: 2px 8px; border: 1px solid; }
  .r-kind.industry { color: var(--cyan); }
  .r-kind.research { color: var(--pink); }
  .role h3 { margin: 0; font-size: clamp(20px, 2.2vw, 26px); font-weight: 600; letter-spacing: -.02em; line-height: 1.25; }
  .r-org { color: var(--ink-2); font-weight: 400; }
  .r-points { margin: 14px 0 16px; padding-left: 18px; color: var(--ink-2); display: grid; gap: 8px; }
  .r-points li::marker { content: '▸  '; color: var(--accent); }

  /* Research */
  .research { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px, 6vw, 80px); margin-top: 56px; }
  .pubs { list-style: none; margin: 0; padding: 0; }
  .pub { display: grid; grid-template-columns: 52px 1fr; gap: 8px; padding: 18px 0; border-top: 1px solid var(--line); }
  .pub-n { color: var(--accent); font-size: 13px; padding-top: 3px; }
  .pub-title { margin: 0; font-size: 17px; line-height: 1.45; }
  .pub-title a { text-decoration: none; }
  .pub-title a:hover { color: var(--accent); }
  .pub-venue { margin: 6px 0 0; font-size: 12px; color: var(--muted); }
  .edu { display: grid; gap: 24px; align-content: start; }
  .edu-card { padding: 24px; border: 1px solid var(--line); background: var(--surface); }
  .edu-card h3 { margin: 6px 0 4px; font-size: 22px; letter-spacing: -.02em; }
  .edu-card p { margin: 0; color: var(--ink-2); }
  .edu-when { font-size: 12px; color: var(--muted) !important; }
  .edu-detail { font-size: 14px; color: var(--muted) !important; margin-top: 6px !important; }
  .edu-score { margin-top: 14px !important; color: var(--accent) !important; font-size: 14px; }

  /* About */
  .about { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: end; margin-top: 18px; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); margin: 0; }
  .stats div { background: var(--bg); padding: 22px; }
  .stats dt { font-size: clamp(36px, 4.4vw, 56px); font-weight: 600; letter-spacing: -.04em; color: var(--accent); line-height: 1; }
  .stats dd { margin: 10px 0 0; font-size: 12px; color: var(--muted); }
  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 72px; }
  .skill h3, .sub { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; font-weight: 500; }
  .extras { margin-top: 72px; }
  .awards { list-style: none; padding: 0; margin: 0; }
  .award { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 18px 0; border-top: 1px solid var(--line); }
  .a-year { color: var(--accent); font-size: 12.5px; padding-top: 4px; }
  .a-title { margin: 0; font-size: 19px; font-weight: 600; letter-spacing: -.01em; }
  .a-event { color: var(--ink-2); font-weight: 400; }
  .a-detail { color: var(--ink-2); margin: 10px 0 14px; max-width: 72ch; }
  .award .arrow-link { display: inline-block; margin-top: 14px; }
  .award.feature { padding: 24px; margin-bottom: 8px; border: 1px solid var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .award.feature .a-title { font-size: clamp(22px, 2.6vw, 30px); }
  .award:has(.a-photo) { grid-template-columns: 64px 1fr minmax(0, 380px); gap: 12px 28px; align-items: start; }
  .a-photo { position: relative; margin: 0; border: 1.5px solid var(--accent); }
  .a-photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 60% 40%; }
  .a-photo .label { position: absolute; left: -1.5px; top: -20px; }

  /* Foundations */
  .fnd-tools { display: flex; justify-content: flex-end; margin-top: 32px; }
  .fnd-tools button { font: inherit; font-size: 12px; color: var(--accent); background: none; border: 0; cursor: pointer; padding: 4px 0; }
  .fnd { list-style: none; padding: 0; margin: 8px 0 0; border-top: 1px solid var(--line-2); }
  .fnd-item { border-bottom: 1px solid var(--line); }
  .fnd-item summary {
    display: grid; grid-template-columns: 64px 1fr auto 28px; gap: 12px; align-items: baseline;
    padding: 16px 0; cursor: pointer; list-style: none; color: var(--ink-2); transition: color .2s, padding .2s;
  }
  .fnd-item summary::-webkit-details-marker { display: none; }
  .f-year { color: var(--muted); font-size: 12.5px; }
  .f-title { font-size: 16.5px; }
  .f-area { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .f-icon { color: var(--accent); font-size: 18px; line-height: 1; justify-self: end; transition: transform .25s; }
  .fnd-item summary:hover, .fnd-item[open] summary { color: var(--ink); }
  .fnd-item summary:hover { padding-left: 8px; }
  .fnd-item summary:hover .f-year, .fnd-item[open] .f-year { color: var(--accent); }
  .fnd-item[open] .f-icon { transform: rotate(45deg); }
  .f-body {
    margin: 0 0 22px 76px; padding: 4px 0 4px 18px; border-left: 2px solid var(--accent);
    color: var(--ink-2); max-width: 72ch; animation: f-open .3s ease-out;
  }
  .f-body p { margin: 0 0 10px; }
  .f-learned { color: var(--ink); }
  .f-learned .mono { color: var(--accent); font-size: 12px; margin-right: 4px; }
  @keyframes f-open { from { opacity: 0; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .f-body { animation: none; } }

  /* Contact */
  .contact .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 36px; }
  .contact .btn.solid { text-transform: none; font-size: 14px; }

  @media (max-width: 900px) {
    .project, .research, .about { grid-template-columns: 1fr; }
    .project:nth-child(even) .p-media { order: 0; }
    .role { grid-template-columns: 1fr; gap: 10px; }
    .r-when { grid-auto-flow: column; justify-content: start; align-items: center; }
    .skills { grid-template-columns: 1fr 1fr; }
    .award:has(.a-photo) { grid-template-columns: 64px 1fr; }
    .a-photo { grid-column: 1 / -1; margin-top: 24px; }
  }
  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; }
    .p-metrics { grid-template-columns: 1fr 1fr; }
    .fnd-item summary { grid-template-columns: 48px 1fr 24px; }
    .f-area { display: none; }
    .f-body { margin-left: 0; }
    .contact .btn.solid { font-size: 12px; padding-inline: 14px; word-break: break-all; }
  }
</style>
